{
  "name": "affilio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "db:up": "docker compose -f deploy/docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f deploy/docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @affilio/core db:generate",
    "db:migrate": "pnpm --filter @affilio/core db:migrate",
    "dev:api": "pnpm --filter @affilio/api dev",
    "dev:worker": "pnpm --filter @affilio/worker dev",
    "dev:web": "pnpm --filter @affilio/web dev",
    "cli": "pnpm --silent --filter @affilio/cli start",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm --filter @affilio/web build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
