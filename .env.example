# ===== Chung =====
NODE_ENV=development
LOG_LEVEL=info

# ===== Postgres =====
# Dev: pnpm db:up mở Postgres ở cổng 5432
DATABASE_URL=postgres://affilio:affilio@localhost:5432/affilio
# Dùng cho container postgres trong deploy/docker-compose.yml
POSTGRES_USER=affilio
# Production: chỉ dùng chữ + số (được ghép thẳng vào DATABASE_URL trong compose)
POSTGRES_PASSWORD=affilio
POSTGRES_DB=affilio

# ===== API =====
API_HOST=0.0.0.0
API_PORT=3100
# Chạy migration khi api khởi động (production bật)
MIGRATE_ON_START=false
# Web dev (pnpm dev:web) proxy /api tới đây; đổi khi đổi API_PORT
API_PROXY_TARGET=http://127.0.0.1:3100

# ===== Worker =====
WORKER_ID=
WORKER_LLM_CONCURRENCY=2
WORKER_RENDER_CONCURRENCY=1

# ===== Temporal =====
# Dev: pnpm db:up mở Temporal ở cổng 7233 (UI http://localhost:8233). Production compose tự đặt temporal:7233.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ===== Storage =====
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# ===== Seed (workspace + user mặc định) =====
SEED_WORKSPACE_NAME=My Channel
SEED_USER_EMAIL=owner@example.com

# ===== Cloudflare Workers AI =====
# Bỏ trống thì tự dùng StubLlm / StubImageGen
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/meta/llama-3.1-8b-instruct
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Hạn mức neurons mỗi ngày (UTC) cho mỗi workspace
CF_DAILY_NEURONS=10000

# ===== Deploy (VPS) =====
DOMAIN=localhost
BASIC_AUTH_USER=admin
# Tạo bằng: docker run --rm caddy:2 caddy hash-password --plaintext 'matkhau'  (nhớ gấp đôi $ thành $$)
BASIC_AUTH_HASH=
# Không kèm tag; workflow deploy đặt IMAGE_TAG = commit sha
IMAGE_APP=ghcr.io/OWNER/affilio-app
IMAGE_WEB=ghcr.io/OWNER/affilio-web
IMAGE_TAG=latest
