{
  "name": "@vm/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config/index.ts",
    "./logger": "./src/logger.ts",
    "./db": "./src/db/index.ts",
    "./spec": "./src/spec/index.ts",
    "./temporal": "./src/temporal/index.ts",
    "./temporal/shared": "./src/temporal/shared.ts",
    "./providers": "./src/providers/index.ts",
    "./storage": "./src/storage/index.ts",
    "./render": "./src/render/index.ts",
    "./video": "./src/video/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@temporalio/client": "^1.26.0",
    "drizzle-orm": "^0.45.4",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
